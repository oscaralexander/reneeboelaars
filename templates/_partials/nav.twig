{% set logo = brand.logoNav.one() %}
{% set logoMobile = brand.logoNavMobile.one() %}

<nav class="nav js-nav">
    <div class="nav__inner">
        <div class="nav__top">
            <button 
                aria-controls="navMenu"
                aria-expanded="false"
                aria-haspopup="true"
                aria-label="Menu"
                class="nav__menuToggle js-navMenuToggle"
                id="navMenuToggle"
            >
                <div></div>
            </button>
            <a class="nav__logoLink" href="{{ siteUrl }}">
                {% if logo or logoMobile %}
                    {% if logoMobile %}
                        <img alt="{{ currentSite.name }}" class="nav__logo nav__logo--desktop" height="{{ logo.height }}" src="{{ logo.url }}" style="aspect-ratio: {{ logo.width ~ '/' ~ logo.height }};" width="{{ logo.width }}">
                        <img alt="{{ currentSite.name }}" class="nav__logo nav__logo--mobile" height="{{ logoMobile.height }}" src="{{ logoMobile.url }}" style="aspect-ratio: {{ logoMobile.width ~ '/' ~ logoMobile.height }};" width="{{ logoMobile.width }}">
                    {% else %}
                        <img alt="{{ currentSite.name }}" class="nav__logo" height="{{ logo.height }}" src="{{ logo.url }}" style="aspect-ratio: {{ logo.width ~ '/' ~ logo.height }};" width="{{ logo.width }}">
                    {% endif %}
                {% else %}
                    {{ currentSite.name }}
                {% endif %}
            </a>
            <div class="nav__menuOverlay js-navMenuOverlay"></div>
            <div
                aria-labelledby="navMenuToggle"
                class="nav__menu js-navMenu"
                id="navMenu"
                role="menubar"
            >
                <ul class="menu nav__menu-menu" role="menu">
                    {% set navPages = craft.entries().section('pages').level(1).includeInNav(true).all() %}
                    {% for page in navPages %}
                        <li class="menu__item">
                            {% if page.hasDescendants %}
                                <span class="menu__link">{{ page.title }}</span>
                            {% else %}
                                <a class="menu__link" href="{{ page.slug == 'home' ? '/' : page.url }}" role="menuitem">{{ page.title }}</a>
                            {% endif %}
                            {% if page.children.includeInNav(true)|length %}
                                <ul class="menu__submenu" role="submenu">
                                    {% for child in page.children.includeInNav(true) %}
                                        <li class="menu__submenu-item">
                                            <a class="menu__submenu-link" href="{{ child.url }}" role="menuitem">{{ child.title }}</a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <footer class="nav__menu-footer">
                    {% if navigation.ctas is not empty %}
                        {% include '_partials/ctas' with { ctas: navigation.ctas } %}
                    {% endif %}
                </footer>
            </div>
            <div class="nav__cta">
                {% if navigation.ctas is not empty %}
                    {% include '_partials/ctas' with { ctas: navigation.ctas } %}
                {% endif %}
            </div>
        </div>
    </div>
</nav>